#!/usr/bin/env node
import { readFileSync } from 'node:fs';

const manifestUrl = new URL('../.claude-plugin/plugin.json', import.meta.url);
const { version } = JSON.parse(readFileSync(manifestUrl, 'utf8'));

const command = process.argv[2];

if (command === '--version') {
  console.log(version);
} else {
  console.error(`masna ${version}: the engine isn't built yet`);
  process.exitCode = 1;
}
